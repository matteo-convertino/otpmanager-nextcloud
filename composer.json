{
    "name": "nextcloud/otpmanager",
    "description": "Nextcloud app that allows you to manage your OTP (TOTP/HOTP) codes easily",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Matteo Convertino",
            "email": "matteo@convertino.cloud",
            "homepage": "https://portfolio.convertino.cloud/"
        }
    ],
    "autoload": {
        "psr-4": {
            "OCA\\OtpManager\\": "lib/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all install --ansi"
        ],
        "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "psalm": "psalm --threads=1 --no-cache",
        "test:unit": "phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
        "openapi": "generate-spec",
        "rector": "rector && composer cs:fix"
    },
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "bamarni/composer-bin-plugin": "^1.8",
        "symfony/validator": "^6.4"
    },
    "require-dev": {
        "nextcloud/ocp": "dev-stable30",
        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1"
        }
    }
}
